+    ["crossSourceConflict", "material_amount_cents"],
+    ["crossSourceConflict", "structural_fields"],
+    ["firstDueConcentration", "window"],
+    ["firstDueConcentration", "material_share_bp"],
+    ["materialSingleCase", "min_delta_bp"],
