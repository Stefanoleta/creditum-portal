+// ─── Saída ────────────────────────────────────────────────────────────────────
+
+/** Por que um candidato não rendeu evento. Tipada, nunca string livre. */
+export type NotEmittedReason =
+  | "NOT_MATERIAL"
+  | "SEVERITY_DIMENSION_UNAVAILABLE"
+  | "DATA_NOT_AVAILABLE"
+  | "NOT_COMPARABLE"
+
+export type CaseOutcome = "material" | "not_material" | "not_comparable"
