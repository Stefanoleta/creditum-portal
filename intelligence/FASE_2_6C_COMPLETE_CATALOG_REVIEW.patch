diff --git a/intelligence/contracts/aros-briefing.schema.json b/intelligence/contracts/aros-briefing.schema.json
new file mode 100644
index 0000000..b01f23c
--- /dev/null
+++ b/intelligence/contracts/aros-briefing.schema.json
@@ -0,0 +1,98 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://creditum.internal/intelligence/contracts/aros-briefing.schema.json",
+  "title": "Briefing sanitizado para o Aros",
+  "description": "Handoff SUPERVISIONADO. Este artefato é gerado, revisado por humano e enviado MANUALMENTE. Não há integração automática com o Aros — não há evidência de API, webhook ou analytics acessível (§4).",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "briefing_id",
+    "schema_version",
+    "generated_at",
+    "approved_by_human",
+    "sanitization",
+    "context",
+    "metrics",
+    "hypotheses",
+    "questions"
+  ],
+  "properties": {
+    "briefing_id": { "$ref": "#/$defs/identifier" },
+    "schema_version": { "$ref": "#/$defs/schema_version" },
+    "generated_at": { "type": "string", "format": "date-time" },
+    "approved_by_human": {
+      "description": "Sempre false na geração. Só um humano flipa para true, e o envio ao Aros é manual.",
+      "type": "boolean"
+    },
+    "sanitization": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["pii_removed", "checks_passed"],
+      "properties": {
+        "pii_removed": { "const": true },
+        "checks_passed": {
+          "description": "TODOS os cinco checks, sem exceção. `minItems: 5` + `uniqueItems` sobre um enum de exatamente cinco valores força o conjunto completo — declarar só `no_cpf` e mandar o briefing para fora era o furo. O Aros recebe material que sai da empresa; sanitização parcial aqui é vazamento com carimbo de aprovado.",
+          "type": "array",
+          "minItems": 5,
+          "maxItems": 5,
+          "uniqueItems": true,
+          "items": { "enum": ["no_cpf", "no_phone", "no_email", "no_person_name", "no_raw_source_text"] }
+        }
+      }
+    },
+    "context": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["period_start", "period_end", "summary"],
+      "properties": {
+        "period_start": { "type": "string", "format": "date" },
+        "period_end": { "type": "string", "format": "date" },
+        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
+        "segment": { "enum": ["ensino_regular", "residencia_medica", "edtech", "todos"] }
+      }
+    },
+    "metrics": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["name", "data_class", "value_repr"],
+        "properties": {
+          "name": { "type": "string", "maxLength": 128 },
+          "data_class": { "enum": ["observed", "calculated", "inferred", "forecast", "gap"] },
+          "value_repr": { "type": "string", "maxLength": 128 },
+          "caveat": { "type": "string", "maxLength": 1000 }
+        }
+      }
+    },
+    "hypotheses": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["statement", "is_inference"],
+        "properties": {
+          "statement": { "type": "string", "maxLength": 2000 },
+          "is_inference": { "const": true },
+          "confidence_bp": { "type": "integer", "minimum": 0, "maximum": 10000 }
+        }
+      }
+    },
+    "questions": {
+      "description": "Perguntas aprovadas para o Aros responder.",
+      "type": "array",
+      "minItems": 1,
+      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
+    },
+    "out_of_scope": {
+      "description": "O que o Aros NÃO deve propor (ex.: qualquer ação que publique, altere CRM ou contate aluno).",
+      "type": "array",
+      "items": { "type": "string", "maxLength": 500 }
+    }
+  },
+  "$defs": {
+    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$" },
+    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
+  }
+}
diff --git a/intelligence/contracts/decision.schema.json b/intelligence/contracts/decision.schema.json
new file mode 100644
index 0000000..64e679e
--- /dev/null
+++ b/intelligence/contracts/decision.schema.json
@@ -0,0 +1,127 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://creditum.internal/intelligence/contracts/decision.schema.json",
+  "title": "Decisão humana (ledger append-only)",
+  "description": "Registro da decisão do responsável humano sobre uma recomendação. Correção NUNCA sobrescreve: cria novo registro com `supersedes` apontando para o anterior (§13).",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "decision_id",
+    "schema_version",
+    "recommendation_id",
+    "run_id",
+    "decided_at",
+    "decided_by_role",
+    "outcome"
+  ],
+  "properties": {
+    "decision_id": { "$ref": "#/$defs/identifier" },
+    "schema_version": { "$ref": "#/$defs/schema_version" },
+    "recommendation_id": { "$ref": "#/$defs/identifier" },
+    "run_id": { "$ref": "#/$defs/identifier" },
+    "decided_at": { "type": "string", "format": "date-time" },
+    "decided_by_role": {
+      "description": "Papel, não nome. O ledger não guarda PII de colaborador.",
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 64
+    },
+    "outcome": { "enum": ["approved", "rejected", "combined", "deepen"] },
+    "chosen_stances": {
+      "description": "Posturas escolhidas. `uniqueItems` porque escolher 'moderate' duas vezes não é uma decisão mais forte — é um registro corrompido.",
+      "type": "array",
+      "maxItems": 3,
+      "uniqueItems": true,
+      "items": { "enum": ["conservative", "moderate", "aggressive"] }
+    },
+    "rationale": { "type": "string", "maxLength": 4000 },
+    "conflict_resolutions": {
+      "description": "Resolução HUMANA de conflitos declarados pelo sistema. É a única via pela qual um conflito pode ser fechado. O conflito original permanece `resolved: false` no snapshot e na recomendação para sempre — a resolução é um evento novo no ledger, vinculado por `conflict_id`, e não uma edição do registro anterior. Quem lê o histórico continua enxergando que houve divergência, quem resolveu e com base em quê.",
+      "type": "array",
+      "items": { "$ref": "#/$defs/conflict_resolution" }
+    },
+    "usefulness_rating": {
+      "description": "Avaliação humana de clareza e capacidade de decidir, 1–5. Critério de aprovação §16 exige média ≥ 4.",
+      "type": "integer",
+      "minimum": 1,
+      "maximum": 5
+    },
+    "supersedes": {
+      "description": "Correção de uma decisão anterior. O registro original permanece intacto.",
+      "$ref": "#/$defs/identifier"
+    },
+    "observed_result": {
+      "description": "Resultado posterior, quando disponível. É o que fecha o ciclo de aprendizado.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["recorded_at", "summary"],
+      "properties": {
+        "recorded_at": { "type": "string", "format": "date-time" },
+        "summary": { "type": "string", "maxLength": 4000 },
+        "amount_cents": { "type": "integer" },
+        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
+      }
+    }
+  },
+  "allOf": [
+    {
+      "description": "Aprovar exige dizer O QUE foi aprovado. Lista vazia é aprovação de nada.",
+      "if": { "properties": { "outcome": { "const": "approved" } }, "required": ["outcome"] },
+      "then": {
+        "required": ["chosen_stances"],
+        "properties": { "chosen_stances": { "type": "array", "minItems": 1 } }
+      }
+    },
+    {
+      "description": "Combinar exige ao menos duas posturas — senão é aprovação simples com outro nome.",
+      "if": { "properties": { "outcome": { "const": "combined" } }, "required": ["outcome"] },
+      "then": {
+        "required": ["chosen_stances"],
+        "properties": { "chosen_stances": { "type": "array", "minItems": 2 } }
+      }
+    }
+  ],
+  "$defs": {
+    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$" },
+    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
+    "conflict_resolution": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["conflict_id", "resolution", "rationale", "resolved_at", "resolved_by_role"],
+      "properties": {
+        "conflict_id": {
+          "description": "Aponta para o conflito original, que continua existindo e continua marcado como não resolvido.",
+          "$ref": "#/$defs/identifier"
+        },
+        "resolution": {
+          "description": "chose_version = uma das versões é a correta. both_wrong = nenhuma serve, a fonte precisa ser corrigida. kept_open = decisão consciente de não resolver ainda. superseded = fonte nova tornou a disputa irrelevante.",
+          "enum": ["chose_version", "both_wrong", "kept_open", "superseded"]
+        },
+        "chosen_version_repr": {
+          "description": "Obrigatório quando resolution = chose_version. Texto da versão escolhida, para que o histórico registre O QUE foi escolhido e não só que houve escolha.",
+          "type": "string",
+          "maxLength": 512
+        },
+        "rationale": {
+          "description": "Por que. Resolver conflito sem justificativa registrada é o mesmo que o sistema ter escolhido sozinho.",
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 4000
+        },
+        "resolved_at": { "type": "string", "format": "date-time" },
+        "resolved_by_role": { "type": "string", "minLength": 1, "maxLength": 64 },
+        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
+      },
+      "allOf": [
+        {
+          "if": {
+            "type": "object",
+            "properties": { "resolution": { "const": "chose_version" } },
+            "required": ["resolution"]
+          },
+          "then": { "required": ["chosen_version_repr"] }
+        }
+      ]
+    }
+  }
+}
diff --git a/intelligence/contracts/event.schema.json b/intelligence/contracts/event.schema.json
new file mode 100644
index 0000000..48c28e0
--- /dev/null
+++ b/intelligence/contracts/event.schema.json
@@ -0,0 +1,478 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://creditum.internal/intelligence/contracts/event.schema.json",
+  "title": "Evento determinístico",
+  "description": "Sinal produzido por um detector em CÓDIGO, não por LLM. O Hermes recebe eventos; ele não os inventa nem recalcula os números que eles carregam.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "event_id",
+    "event_type",
+    "detector_id",
+    "detector_version",
+    "snapshot_ids",
+    "period_start",
+    "period_end",
+    "detected_at",
+    "severity",
+    "materiality",
+    "evidence_refs",
+    "data_quality"
+  ],
+  "properties": {
+    "event_id": {
+      "$ref": "#/$defs/identifier"
+    },
+    "event_type": {
+      "description": "Allowlist fechada. Um detector não pode inventar um tipo novo sem passar por revisão. `low_ticket_contract` adicionado na Fase 2.6b: contrato individual abaixo do piso comercial aprovado de R$ 1.499,99. É alerta operacional factual — não afirma fraude, erro, prejuízo nem risco.",
+      "enum": [
+        "installment_concentration",
+        "data_quality_conflict",
+        "first_due_date_concentration",
+        "material_single_case",
+        "coverage_degraded",
+        "low_ticket_contract"
+      ]
+    },
+    "detector_id": {
+      "$ref": "#/$defs/identifier"
+    },
+    "detector_version": {
+      "$ref": "#/$defs/schema_version"
+    },
+    "snapshot_ids": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "$ref": "#/$defs/identifier"
+      }
+    },
+    "period_start": {
+      "type": "string",
+      "format": "date"
+    },
+    "period_end": {
+      "type": "string",
+      "format": "date"
+    },
+    "detected_at": {
+      "type": "string",
+      "format": "date-time"
+    },
+    "severity": {
+      "enum": [
+        "info",
+        "low",
+        "medium",
+        "high",
+        "critical"
+      ]
+    },
+    "materiality": {
+      "$ref": "#/$defs/materiality"
+    },
+    "observed_metric": {
+      "$ref": "#/$defs/metric"
+    },
+    "reference_metric": {
+      "description": "Referência contra a qual o observado foi comparado (baseline, meta, período anterior).",
+      "$ref": "#/$defs/metric"
+    },
+    "contributing_cases": {
+      "description": "Casos individuais responsáveis pelo impacto. Identificados por pseudônimo estável — NUNCA nome, CPF, telefone ou e-mail.",
+      "type": "array",
+      "items": {
+        "$ref": "#/$defs/contributing_case"
+      }
+    },
+    "evidence_refs": {
+      "type": "array",
+      "minItems": 1,
+      "uniqueItems": true,
+      "items": {
+        "$ref": "#/$defs/identifier"
+      }
+    },
+    "data_quality": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "quality_status"
+      ],
+      "properties": {
+        "quality_status": {
+          "enum": [
+            "ok",
+            "degraded",
+            "conflicted",
+            "insufficient"
+          ]
+        },
+        "conflict_ids": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/identifier"
+          }
+        },
+        "missing_fields": {
+          "type": "array",
+          "items": {
+            "type": "string",
+            "maxLength": 128
+          }
+        },
+        "coverage_ratio_bp": {
+          "$ref": "#/$defs/basis_points"
+        }
+      }
+    }
+  },
+  "$defs": {
+    "identifier": {
+      "type": "string",
+      "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$"
+    },
+    "schema_version": {
+      "type": "string",
+      "pattern": "^\\d+\\.\\d+\\.\\d+$"
+    },
+    "basis_points": {
+      "type": "integer",
+      "minimum": 0,
+      "maximum": 10000
+    },
+    "cents": {
+      "description": "Dinheiro é SEMPRE inteiro em centavos. Nunca float.",
+      "type": "integer",
+      "minimum": -9007199254740991,
+      "maximum": 9007199254740991
+    },
+    "subject_ref": {
+      "description": "Pseudônimo estável e segregado. Não é derivável de PII sem a tabela de correspondência, que vive fora do plano de consulta.",
+      "type": "string",
+      "pattern": "^subj_[a-f0-9]{16}$"
+    },
+    "materiality": {
+      "description": "Quanto do consolidado este evento move. É o que separa ruído de coisa que merece o tempo do humano. O `basis` declara a unidade — e o campo correspondente passa a ser obrigatório, senão o evento diz 'meço em reais' sem dizer quantos.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "basis"
+      ],
+      "properties": {
+        "basis": {
+          "enum": [
+            "amount_cents",
+            "count",
+            "ratio_bp"
+          ]
+        },
+        "amount_cents": {
+          "$ref": "#/$defs/cents"
+        },
+        "count": {
+          "type": "integer",
+          "minimum": 0
+        },
+        "ratio_bp": {
+          "$ref": "#/$defs/basis_points"
+        },
+        "share_of_total_bp": {
+          "description": "Participação no consolidado do período, em basis points.",
+          "$ref": "#/$defs/basis_points"
+        }
+      },
+      "allOf": [
+        {
+          "if": {
+            "type": "object",
+            "properties": {
+              "basis": {
+                "const": "amount_cents"
+              }
+            },
+            "required": [
+              "basis"
+            ]
+          },
+          "then": {
+            "required": [
+              "amount_cents"
+            ]
+          }
+        },
+        {
+          "if": {
+            "type": "object",
+            "properties": {
+              "basis": {
+                "const": "count"
+              }
+            },
+            "required": [
+              "basis"
+            ]
+          },
+          "then": {
+            "required": [
+              "count"
+            ]
+          }
+        },
+        {
+          "if": {
+            "type": "object",
+            "properties": {
+              "basis": {
+                "const": "ratio_bp"
+              }
+            },
+            "required": [
+              "basis"
+            ]
+          },
+          "then": {
+            "required": [
+              "ratio_bp"
+            ]
+          }
+        }
+      ]
+    },
+    "metric": {
+      "description": "Classe do dado explícita. Ausência NUNCA vira zero. A classe de um agregado é a mais fraca das entradas.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "name",
+        "data_class"
+      ],
+      "properties": {
+        "name": {
+          "type": "string",
+          "pattern": "^[a-z][a-z0-9_]{0,127}$"
+        },
+        "data_class": {
+          "enum": [
+            "observed",
+            "calculated",
+            "inferred",
+            "forecast",
+            "gap"
+          ]
+        },
+        "unit": {
+          "enum": [
+            "cents",
+            "count",
+            "basis_points",
+            "days"
+          ]
+        },
+        "value": {
+          "type": "integer"
+        },
+        "formula": {
+          "type": "string",
+          "minLength": 1,
+          "maxLength": 512
+        },
+        "confidence_bp": {
+          "$ref": "#/$defs/basis_points"
+        },
+        "range_low": {
+          "type": "integer"
+        },
+        "range_high": {
+          "type": "integer"
+        },
+        "gap_reason": {
+          "enum": [
+            "DATA_NOT_AVAILABLE",
+            "DATA_CONFLICT",
+            "LOW_CONFIDENCE",
+            "EMPTY_DENOMINATOR",
+            "INSUFFICIENT_COVERAGE",
+            "BUSINESS_RULE_PENDING"
+          ]
+        }
+      },
+      "allOf": [
+        {
+          "if": {
+            "type": "object",
+            "properties": {
+              "data_class": {
+                "const": "observed"
+              }
+            },
+            "required": [
+              "data_class"
+            ]
+          },
+          "then": {
+            "required": [
+              "value"
+            ]
+          }
+        },
+        {
+          "if": {
+            "type": "object",
+            "properties": {
+              "data_class": {
+                "const": "calculated"
+              }
+            },
+            "required": [
+              "data_class"
+            ]
+          },
+          "then": {
+            "required": [
+              "formula",
+              "value"
+            ]
+          }
+        },
+        {
+          "if": {
+            "type": "object",
+            "properties": {
+              "data_class": {
+                "const": "inferred"
+              }
+            },
+            "required": [
+              "data_class"
+            ]
+          },
+          "then": {
+            "required": [
+              "confidence_bp",
+              "value"
+            ]
+          }
+        },
+        {
+          "if": {
+            "type": "object",
+            "properties": {
+              "data_class": {
+                "const": "forecast"
+              }
+            },
+            "required": [
+              "data_class"
+            ]
+          },
+          "then": {
+            "required": [
+              "confidence_bp",
+              "range_low",
+              "range_high"
+            ]
+          }
+        },
+        {
+          "if": {
+            "type": "object",
+            "properties": {
+              "data_class": {
+                "const": "gap"
+              }
+            },
+            "required": [
+              "data_class"
+            ]
+          },
+          "then": {
+            "required": [
+              "gap_reason"
+            ],
+            "allOf": [
+              {
+                "not": {
+                  "required": [
+                    "value"
+                  ]
+                }
+              },
+              {
+                "not": {
+                  "required": [
+                    "range_low"
+                  ]
+                }
+              },
+              {
+                "not": {
+                  "required": [
+                    "range_high"
+                  ]
+                }
+              },
+              {
+                "not": {
+                  "required": [
+                    "formula"
+                  ]
+                }
+              },
+              {
+                "not": {
+                  "required": [
+                    "confidence_bp"
+                  ]
+                }
+              }
+            ]
+          }
+        }
+      ]
+    },
+    "contributing_case": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "subject_ref",
+        "contribution"
+      ],
+      "properties": {
+        "subject_ref": {
+          "$ref": "#/$defs/subject_ref"
+        },
+        "contribution": {
+          "description": "Ao menos uma grandeza. Um caso 'contribuinte' sem contribuição declarada é ruído com aparência de evidência.",
+          "type": "object",
+          "additionalProperties": false,
+          "minProperties": 1,
+          "properties": {
+            "amount_cents": {
+              "$ref": "#/$defs/cents"
+            },
+            "count": {
+              "type": "integer",
+              "minimum": 0
+            },
+            "share_of_event_bp": {
+              "$ref": "#/$defs/basis_points"
+            }
+          }
+        },
+        "unit": {
+          "description": "Unidade/escola já normalizada para o nome canônico aprovado pelo CEO (D13).",
+          "type": "string",
+          "pattern": "^[A-ZÀ-Ý][A-Za-zÀ-ÿ ]{1,63}$"
+        },
+        "evidence_refs": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/identifier"
+          }
+        }
+      }
+    }
+  }
+}
diff --git a/intelligence/contracts/evidence.schema.json b/intelligence/contracts/evidence.schema.json
new file mode 100644
index 0000000..59d5bbe
--- /dev/null
+++ b/intelligence/contracts/evidence.schema.json
@@ -0,0 +1,90 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://creditum.internal/intelligence/contracts/evidence.schema.json",
+  "title": "Evidência",
+  "description": "Âncora rastreável entre uma afirmação e o lugar exato da fonte que a sustenta. Todo número apresentado ao humano precisa de pelo menos uma.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["evidence_id", "snapshot_id", "kind", "locator", "observed_at"],
+  "properties": {
+    "evidence_id": { "$ref": "#/$defs/identifier" },
+    "snapshot_id": { "$ref": "#/$defs/identifier" },
+    "kind": {
+      "description": "cell/row = localização na fonte. computed = resultado de fórmula determinística. absence = a ausência É a evidência (ex.: campo nunca preenchido).",
+      "enum": ["cell", "row", "aggregate", "computed", "absence"]
+    },
+    "locator": {
+      "description": "Onde exatamente. Nunca inclui conteúdo de PII. A especificidade exigida depende do `kind` — ver allOf.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["dataset_id"],
+      "properties": {
+        "dataset_id": { "type": "string", "minLength": 1, "maxLength": 256 },
+        "sheet": { "type": "string", "minLength": 1, "maxLength": 128 },
+        "row_key": {
+          "description": "sha256(fonte|dataset|aba|posição) — nunca o número de linha sozinho (D6).",
+          "$ref": "#/$defs/sha256"
+        },
+        "column": { "type": "string", "minLength": 1, "maxLength": 128 }
+      }
+    },
+    "observed_at": { "type": "string", "format": "date-time" },
+    "formula": {
+      "description": "Obrigatória quando kind = computed. Métrica calculada sem fórmula é inválida por construção.",
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 512
+    },
+    "untrusted_excerpt": { "$ref": "#/$defs/untrusted_text" }
+  },
+  "allOf": [
+    {
+      "if": { "type": "object", "properties": { "kind": { "const": "computed" } }, "required": ["kind"] },
+      "then": { "required": ["formula"] }
+    },
+    {
+      "description": "Uma célula é a interseção de linha e coluna. Sem as duas, 'cell' é só um rótulo — e uma afirmação ancorada num lugar impreciso não é rastreável.",
+      "if": { "type": "object", "properties": { "kind": { "const": "cell" } }, "required": ["kind"] },
+      "then": {
+        "properties": {
+          "locator": { "type": "object", "required": ["sheet", "row_key", "column"] }
+        },
+        "required": ["locator"]
+      }
+    },
+    {
+      "if": { "type": "object", "properties": { "kind": { "const": "row" } }, "required": ["kind"] },
+      "then": {
+        "properties": {
+          "locator": { "type": "object", "required": ["sheet", "row_key"] }
+        },
+        "required": ["locator"]
+      }
+    },
+    {
+      "description": "Agregado precisa dizer sobre o quê agregou.",
+      "if": { "type": "object", "properties": { "kind": { "const": "aggregate" } }, "required": ["kind"] },
+      "then": {
+        "properties": {
+          "locator": { "type": "object", "required": ["sheet"] }
+        },
+        "required": ["locator"]
+      }
+    }
+  ],
+  "$defs": {
+    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$" },
+    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+    "untrusted_text": {
+      "description": "Envelope obrigatório para QUALQUER texto vindo da fonte. O rótulo existe para que o texto seja tratado como dado, nunca como instrução (§12.3).",
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["untrusted", "content"],
+      "properties": {
+        "untrusted": { "const": true },
+        "content": { "type": "string", "maxLength": 2048 },
+        "origin": { "type": "string", "maxLength": 256 }
+      }
+    }
+  }
+}
diff --git a/intelligence/contracts/recommendation.schema.json b/intelligence/contracts/recommendation.schema.json
new file mode 100644
index 0000000..114d3d6
--- /dev/null
+++ b/intelligence/contracts/recommendation.schema.json
@@ -0,0 +1,332 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://creditum.internal/intelligence/contracts/recommendation.schema.json",
+  "title": "Recomendação do Hermes Observer",
+  "description": "Saída estruturada do runtime agêntico. Falha de validação contra este schema IMPEDE que a resposta seja apresentada como recomendação — vira registro de falha no ledger (§8.3).",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "recommendation_id",
+    "schema_version",
+    "run_id",
+    "generated_at",
+    "fact",
+    "provenance",
+    "data_quality",
+    "confidence_bp",
+    "alternatives",
+    "combinable",
+    "human_decision_required",
+    "review_by"
+  ],
+  "properties": {
+    "recommendation_id": { "$ref": "#/$defs/identifier" },
+    "schema_version": { "$ref": "#/$defs/schema_version" },
+    "run_id": { "$ref": "#/$defs/identifier" },
+    "generated_at": { "type": "string", "format": "date-time" },
+
+    "fact": {
+      "description": "O fato detectado, ancorado. Nenhuma afirmação numérica sem evidência e timestamp.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["statement", "event_ids", "snapshot_ids", "evidence_refs", "observed_at"],
+      "properties": {
+        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
+        "event_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
+        "snapshot_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
+        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } },
+        "observed_at": { "type": "string", "format": "date-time" },
+        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric_ref" } }
+      }
+    },
+
+    "probable_cause": {
+      "description": "Causa provável. O campo `is_inference` é const true: por construção não existe causa 'observada' aqui.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["is_inference", "statement", "confidence_bp"],
+      "properties": {
+        "is_inference": { "const": true },
+        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
+        "confidence_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
+        "competing_explanations": {
+          "type": "array",
+          "items": { "type": "string", "maxLength": 1000 }
+        },
+        "what_would_falsify_it": {
+          "description": "Que dado derrubaria esta hipótese. Sem isso a inferência não é auditável.",
+          "type": "string",
+          "maxLength": 1000
+        }
+      }
+    },
+
+    "data_quality": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["quality_status", "conflicts", "gaps"],
+      "properties": {
+        "quality_status": { "enum": ["ok", "degraded", "conflicted", "insufficient"] },
+        "conflicts": {
+          "description": "Conflitos DECLARADOS. Escolher silenciosamente um dos lados é falha bloqueante do Bloco 1.",
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["conflict_id", "field", "versions_repr", "resolved"],
+            "properties": {
+              "conflict_id": { "$ref": "#/$defs/identifier" },
+              "field": { "type": "string", "maxLength": 128 },
+              "versions_repr": {
+                "type": "array",
+                "minItems": 2,
+                "items": { "type": "string", "minLength": 1, "maxLength": 512 }
+              },
+              "resolved": {
+                "description": "OBRIGATÓRIO e sempre false. Omitir era um furo: uma recomendação sem o campo passava sem afirmar nada, e a arquitetura depende de o agente NUNCA fechar conflito.",
+                "const": false
+              }
+            }
+          }
+        },
+        "gaps": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["field", "reason"],
+            "properties": {
+              "field": { "type": "string", "maxLength": 128 },
+              "reason": {
+                "enum": [
+                  "DATA_NOT_AVAILABLE",
+                  "DATA_CONFLICT",
+                  "LOW_CONFIDENCE",
+                  "EMPTY_DENOMINATOR",
+                  "INSUFFICIENT_COVERAGE",
+                  "BUSINESS_RULE_PENDING"
+                ]
+              }
+            }
+          }
+        },
+        "coverage_ratio_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
+        "data_age_hours": { "type": "integer", "minimum": 0 }
+      }
+    },
+
+    "confidence_bp": {
+      "description": "Confiança global na recomendação. Pressão do usuário por certeza não pode elevá-la (teste adversarial §15).",
+      "type": "integer",
+      "minimum": 0,
+      "maximum": 10000
+    },
+
+    "alternatives": {
+      "description": "Exatamente três, uma por postura. Não é permitido devolver só a preferida.",
+      "type": "array",
+      "minItems": 3,
+      "maxItems": 3,
+      "items": { "$ref": "#/$defs/alternative" },
+      "allOf": [
+        {
+          "contains": { "type": "object", "properties": { "stance": { "const":"conservative" } }, "required": ["stance"] },
+          "minContains": 1,
+          "maxContains": 1
+        },
+        {
+          "contains": { "type": "object", "properties": { "stance": { "const":"moderate" } }, "required": ["stance"] },
+          "minContains": 1,
+          "maxContains": 1
+        },
+        {
+          "contains": { "type": "object", "properties": { "stance": { "const":"aggressive" } }, "required": ["stance"] },
+          "minContains": 1,
+          "maxContains": 1
+        }
+      ]
+    },
+
+    "combinable": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["is_combinable"],
+      "properties": {
+        "is_combinable": { "type": "boolean" },
+        "viable_combinations": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": ["stances", "note"],
+            "properties": {
+              "stances": {
+                "type": "array",
+                "minItems": 2,
+                "maxItems": 3,
+                "items": { "enum": ["conservative", "moderate", "aggressive"] }
+              },
+              "note": { "type": "string", "maxLength": 1000 }
+            }
+          }
+        },
+        "mutually_exclusive_note": { "type": "string", "maxLength": 1000 }
+      }
+    },
+
+    "horizons": {
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "immediate": { "$ref": "#/$defs/horizon_actions" },
+        "short_term": { "$ref": "#/$defs/horizon_actions" },
+        "medium_term": { "$ref": "#/$defs/horizon_actions" },
+        "long_term": { "$ref": "#/$defs/horizon_actions" }
+      }
+    },
+
+    "human_decision_required": {
+      "description": "Sempre true nesta fase. O padrão de autonomia é OBSERVAR → ANALISAR → ALERTAR → RECOMENDAR; executar não está no conjunto.",
+      "const": true
+    },
+
+    "review_by": { "type": "string", "format": "date" },
+
+    "provenance": {
+      "description": "Preenchido pelo capturador EXTERNO, a partir do que foi de fato invocado — não pelo que o agente diz ter usado.",
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["provider", "model", "prompt_version", "config_hash"],
+      "properties": {
+        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
+        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
+        "prompt_version": { "$ref": "#/$defs/schema_version" },
+        "skill_id": { "type": "string", "maxLength": 128 },
+        "skill_version": { "$ref": "#/$defs/schema_version" },
+        "config_hash": { "$ref": "#/$defs/sha256" },
+        "fallback_used": { "type": "boolean" }
+      }
+    }
+  },
+
+  "$defs": {
+    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{2,127}$" },
+    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
+    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
+    "metric_ref": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["name", "data_class"],
+      "properties": {
+        "name": { "type": "string", "maxLength": 128 },
+        "data_class": { "enum": ["observed", "calculated", "inferred", "forecast", "gap"] },
+        "value_repr": { "type": "string", "maxLength": 128 },
+        "unit": { "enum": ["cents", "count", "basis_points", "days"] },
+        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
+      }
+    },
+    "alternative": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "stance",
+        "summary",
+        "rationale",
+        "benefit",
+        "risk",
+        "impact",
+        "tradeoffs",
+        "likely_consequences"
+      ],
+      "properties": {
+        "stance": { "enum": ["conservative", "moderate", "aggressive"] },
+        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
+        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
+        "benefit": { "type": "string", "minLength": 1, "maxLength": 2000 },
+        "risk": { "type": "string", "minLength": 1, "maxLength": 2000 },
+        "impact": {
+          "description": "O impacto obedece às mesmas invariantes de classe de dado do resto do sistema. Sem isso, uma alternativa podia declarar `forecast` e entregar um número seco, que é exatamente o tipo de falsa precisão que o projeto existe para evitar.",
+          "type": "object",
+          "additionalProperties": false,
+          "required": ["data_class"],
+          "properties": {
+            "data_class": { "enum": ["calculated", "inferred", "forecast", "gap"] },
+            "amount_cents": { "type": "integer" },
+            "range_low_cents": { "type": "integer" },
+            "range_high_cents": { "type": "integer" },
+            "confidence_bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
+            "narrative": { "type": "string", "minLength": 1, "maxLength": 1000 }
+          },
+          "allOf": [
+            {
+              "if": {
+                "type": "object",
+                "properties": { "data_class": { "const": "calculated" } },
+                "required": ["data_class"]
+              },
+              "then": {
+                "required": ["amount_cents"],
+                "allOf": [
+                  { "not": { "required": ["range_low_cents"] } },
+                  { "not": { "required": ["range_high_cents"] } }
+                ]
+              }
+            },
+            {
+              "if": {
+                "type": "object",
+                "properties": { "data_class": { "const": "inferred" } },
+                "required": ["data_class"]
+              },
+              "then": { "required": ["amount_cents", "confidence_bp"] }
+            },
+            {
+              "if": {
+                "type": "object",
+                "properties": { "data_class": { "const": "forecast" } },
+                "required": ["data_class"]
+              },
+              "then": { "required": ["range_low_cents", "range_high_cents", "confidence_bp"] }
+            },
+            {
+              "if": {
+                "type": "object",
+                "properties": { "data_class": { "const": "gap" } },
+                "required": ["data_class"]
+              },
+              "then": {
+                "required": ["narrative"],
+                "allOf": [
+                  { "not": { "required": ["amount_cents"] } },
+                  { "not": { "required": ["range_low_cents"] } },
+                  { "not": { "required": ["range_high_cents"] } },
+                  { "not": { "required": ["confidence_bp"] } }
+                ]
+              }
+            }
+          ]
+        },
+        "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 1000 } },
+        "likely_consequences": {
+          "type": "array",
+          "minItems": 1,
+          "items": { "type": "string", "maxLength": 1000 }
+        },
+        "reversible": { "type": "boolean" }
+      }
+    },
+    "horizon_actions": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": ["action", "owner_role"],
+        "properties": {
+          "action": { "type": "string", "minLength": 1, "maxLength": 1000 },
+          "owner_role": { "type": "string", "maxLength": 128 },
+          "depends_on_stance": { "enum": ["conservative", "moderate", "aggressive", "any"] }
+        }
+      }
+    }
+  }
+}
