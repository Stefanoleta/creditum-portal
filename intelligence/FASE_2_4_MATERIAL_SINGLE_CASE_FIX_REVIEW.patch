+  })
+
+  it("MÉDIA: sem o item === recomputação independente da coleção sem o item", () => {
+    for (const valores of conjuntos) {
+      const r = detectar(valores.map((v) => caso(v)), comMetrica("amount_mean_cents"))
+      for (const i of valores.keys()) {
