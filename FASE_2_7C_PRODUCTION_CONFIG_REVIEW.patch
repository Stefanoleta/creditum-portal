+
+  it("não vaza texto cru de unidade nem consome campo de outro detector", () => {
+    const json = JSON.stringify(r)
+    expect(json).not.toContain("Grau Mogi")
+    expect(json).not.toContain("Carpina e Limoeiro")
+  })
+})
