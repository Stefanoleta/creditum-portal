+// ═════════════════════════════════════════════════════════════════════════════
+// Detector B
+// ═════════════════════════════════════════════════════════════════════════════
+
+describe("Detector B sob a política de produção", () => {
+  const outroSnapshot = toSnapshot(
+    rawSnapshot({
+      snapshot_id: "snap_prod_financeiro",
+      source_system: "omie",
+      dataset_id: "ds_financeiro_mensal",
