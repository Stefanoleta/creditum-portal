+function contrato(
+  first_due_date_raw: unknown,
+  amount_cents: number | null = 100_000,
+  unit: CanonicalUnitResult = MATCHED,
+): DueContractRecord {
+  return {
+    subject_ref: subjectRef(),
+    unit,
+    first_due_date_raw,
+    amount_cents,
+    evidence_refs: ["ev_linha"],
