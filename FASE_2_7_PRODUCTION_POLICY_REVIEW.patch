+      return
+    }
+    throw new Error("esperava recusa")
+  })
+
+  it("sem pendências, a projeção passa", () => {
+    expect(() => assertProductionPolicyComplete([])).not.toThrow()
+  })
+
+  it("o artefato não fabrica um valor para os campos pendentes", () => {
+    const pend = ARTEFATO["unresolved_requires_human_decision"] as Record<string, unknown>
+    const dims = pend["severity_basis_dimension"] as Record<string, string[]>
+    // Cada entrada lista os CANDIDATOS, não uma escolha.
