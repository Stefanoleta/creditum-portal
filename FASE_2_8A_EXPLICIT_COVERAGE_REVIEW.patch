+    { now: new Date(DETECTED_AT) },
+  )
+
+  const evOutro = toEvidence(
+    rawEvidence({
+      evidence_id: "ev_agg_omie",
+      snapshot_id: "snap_prod_financeiro",
+      kind: "aggregate",
+      locator: { dataset_id: "ds_financeiro_mensal", sheet: "Financeiro" },
