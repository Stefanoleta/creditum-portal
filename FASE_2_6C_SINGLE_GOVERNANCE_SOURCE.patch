+function planilha(linhas: readonly Linha[]): string {
+  const dir = mkdtempSync(join(tmpdir(), "cat-import-"))
+  const caminho = join(dir, "teste.xlsx")
+  execFileSync("python3", [GERADOR, caminho, JSON.stringify(linhas)], { encoding: "utf8" })
+  return caminho
